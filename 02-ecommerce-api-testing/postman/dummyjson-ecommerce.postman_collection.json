  "item": [
    {
      "name": "01 - Get all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Products is an array\", function () { pm.expect(data.products).to.be.an(\"array\"); });",
              "pm.test(\"Pagination fields exist\", function () {",
              "    pm.expect(data).to.have.property(\"total\");",
              "    pm.expect(data).to.have.property(\"limit\");",
              "});"
            ]
          }
        }
      ]
    },
