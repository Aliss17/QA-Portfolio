    {
      "name": "07 - Login (set collection variables first)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Set username and password collection variables using current credentials in DummyJSON documentation before running.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"expiresInMins\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Authentication response is successful\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const data = pm.response.json();",
              "pm.test(\"Token field is returned\", function () {",
              "    pm.expect(data).to.have.property(\"accessToken\");",
              "});",
              "if (data.accessToken) {",
              "    pm.collectionVariables.set(\"accessToken\", data.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
